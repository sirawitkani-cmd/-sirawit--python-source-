#แสดงผลหน้าเจอ 100 THB = 3.3 USD

def convert_currency(a,b)
    if b == "USD"
        print(f"{a} THB = {a/ 32.0} USD")
    else:
        print(a "USD = ", a* 32.0 "THB")
#แปลงเงิน
convert_currency(100, "USD")
convert_currency(100, "THB")